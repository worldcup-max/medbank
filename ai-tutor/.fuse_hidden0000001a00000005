<script>
(function(){
  var $=function(id){return document.getElementById(id);};
  if(!$('tChat')) return;
  var chat=$('tChat'), inp=$('tInput');
  var tsec=41*60+15;
  function fmtT(s){var h=Math.floor(s/3600),m=Math.floor(s%3600/60),ss=s%60;return (h?h+':'+String(m).padStart(2,'0'):m)+':'+String(ss).padStart(2,'0');}
  setInterval(function(){ tsec++; var e=$('tuTime'); if(e)e.textContent=fmtT(tsec); },1000);
  function resetCursor(){ var c=$('tuCursor'); c.style.left='40px'; c.style.top='250px'; }
  function moveTo(el, cb){ var main=$('tuCursor').parentNode, mr=main.getBoundingClientRect(), er=el.getBoundingClientRect();
    var cur=$('tuCursor'); cur.style.left=(er.left-mr.left+er.width/2)+'px'; cur.style.top=(er.top-mr.top+er.height/2-8)+'px';
    setTimeout(function(){ cur.classList.add('click'); setTimeout(function(){ cur.classList.remove('click'); cb&&cb(); },320); },1350); }
  var Q=[
    {u:'Why is the vomiting non-bilious?',
     a:'Because the blockage sits at the <b>pylorus</b> — above where bile enters the duodenum. Stomach milk comes straight back up, but bile never reaches it. That\'s the giveaway versus a lower obstruction.',
     cite:'Pyloric stenosis · your note'},
    {u:'How do I tell it apart from reflux?',
     a:'Reflux is <b>effortless posseting</b> and the baby thrives. Pyloric stenosis is <b>forceful, projectile</b>, the baby is hungry again right after, and you can feel the olive-shaped mass.',
     cite:'Pyloric stenosis · your note'}
  ];
  function typewriter(text, cb){ inp.innerHTML=''; var i=0; (function tick(){ if(i<=text.length){ inp.innerHTML='<b>'+text.slice(0,i)+'</b><span style="opacity:.5">▍</span>'; i++; setTimeout(tick, 34); } else { inp.innerHTML='<b>'+text+'</b>'; cb&&cb(); } })(); }
  function bubble(cls, html){ var d=document.createElement('div'); d.className='msg '+cls; d.innerHTML=html; chat.appendChild(d); return d; }
  function ask(i, done){
    var k=Q[i];
    typewriter(k.u, function(){
      moveTo($('tSend'), function(){
        inp.innerHTML='';
        bubble('user', k.u);
        var t=bubble('ai typing','<span></span><span></span><span></span>');
        setTimeout(function(){ t.remove(); bubble('ai', k.a+'<div class="cite">📖 '+k.cite+'</div>'); setTimeout(done, 3400); }, 1500);
      });
    });
  }
  function loop(){ chat.innerHTML=''; inp.innerHTML=''; resetCursor();
    setTimeout(function(){ ask(0, function(){ ask(1, function(){ setTimeout(loop, 3000); }); }); }, 1100); }
  setTimeout(loop, 800);
})();
</script>
