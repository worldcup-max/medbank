     answer:'Fast-rising jaundice this early is not physiological — plot bilirubin on the hour-specific chart and start phototherapy.',
     bullets:['Jaundice under 24h is always pathological','Use the hour-specific nomogram before you decide'],
     callout:'Physiological jaundice appears <b>after 24 hours</b> and climbs slowly — early, rapid jaundice needs investigation.',
     sched:'tomorrow'},
    {head:'3-DAY REVIEW · OBSTETRICS',
     q:'A woman at 34 weeks has BP 158/104, proteinuria and a headache. Besides antihypertensives, which drug most reduces her seizure risk?',
     opts:['Diazepam','Magnesium sulfate','Phenytoin','Labetalol alone'], ans:1,
     answer:'Magnesium sulfate is the drug of choice to prevent and treat eclamptic seizures in severe pre-eclampsia.',
     bullets:['MgSO₄ beats diazepam and phenytoin for seizure prevention','Monitor reflexes, respiratory rate and urine output for toxicity'],
     callout:'The definitive treatment of pre-eclampsia is <b>delivery</b> — MgSO₄ and BP control buy time to do it safely.',
     sched:'in a week'}
  ];
  function explHTML(k){ var b=k.bullets.map(function(x){return '<li>'+x+'</li>';}).join('');
    return '<div class="axtag">ANSWER — EXPLAINED</div><div class="axans">'+k.answer+'</div><div class="axh">Understanding it</div><ul class="axul">'+b+'</ul><div class="axcall">'+k.callout+'</div>'; }
  function cardHTML(k){ var o=k.opts.map(function(x,i){return '<div class="dopt" id="aopt'+i+'"><span class="tag">'+String.fromCharCode(65+i)+'</span><span>'+x+'</span></div>';}).join('');
    return '<div class="dmcq"><div class="qhead">'+k.head+'</div><div class="qtext">'+k.q+'</div><div id="aopts">'+o+'</div><div id="ares"></div></div>'; }
  function runCard(i, done){
    freeScene(); var k=SC[i]; scene.innerHTML=cardHTML(k); resetCursor();
    setTimeout(function(){
      moveTo($('aopt'+k.ans), function(){
        $('aopt'+k.ans).classList.add('correct');
        $('ares').innerHTML='<div class="mcqres ok">✓ Correct</div><div class="nextrev ok">↻ You’ll see this again <b>'+k.sched+'</b></div><div class="dexpl show" style="margin-top:14px">'+explHTML(k)+'</div>';
        setTimeout(done, 5400);
      });
    }, 1700);
  }

  // ---- sequence ----
  function play(){
    side('home'); timerRun(false); freeScene(); scene.innerHTML=homeHTML(); resetCursor();
    setTimeout(function(){ moveTo($('arOpen'), function(){
      side('recall'); scene.innerHTML=hubHTML(); resetCursor();
      scene.style.maxHeight='300px'; scene.style.overflow='hidden'; scene.scrollTop=0;
      setTimeout(function(){ scrollTween(scene,170,1500,function(){ setTimeout(function(){ scrollTween(scene,0,1200,function(){
        setTimeout(function(){ moveTo($('arStart'), function(){
          freeScene(); timerRun(true);
          runCard(0, function(){ runCard(1, function(){
            timerRun(false); freeScene(); scene.innerHTML=doneHTML(); resetCursor();
            setTimeout(play, 3200);
          }); });
        }); }, 700);
      }); }, 1300); }); }, 1500);
    }); }, 2400);
  }
  setTimeout(play, 800);
})();
</script>
<script>
  document.getElementById('yr').textContent=new Date().getFullYear();
  document.querySelectorAll('.qa').forEach(function(d){ d.addEventListener('toggle',function(){ if(d.open){ document.querySelectorAll('.qa').forEach(function(o){ if(o!==d) o.open=false; }); } }); });
</script>
