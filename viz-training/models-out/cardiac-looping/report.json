  "spec": {
   "axes": "+x = embryo LEFT, -x = RIGHT, +y = CRANIAL, +z = VENTRAL",
   "at_t": 1,
   "tests": [
    {
     "id": "A",
     "says": "the bulboventricular limb is convex VENTRALLY",
     "must": "ventricle centroid z > 0"
    },
    {
     "id": "B'",
     "says": "the loop is DEXTRAL — a property of the CONVEXITY, not of the ventricle side",
     "must": "bulbus centroid x < 0 AND the bulbus bows to the embryo's RIGHT (its convexity < 0)"
    },
    {
     "id": "C",
     "says": "the atrium lies BEHIND the ventricle",
     "must": "atrium z - ventricle z < 0"
    },
    {
     "id": "D",
     "says": "the atria lie ABOVE the ventricles, visibly",
     "must": "(atrium y - ventricle y) >= 0.35 x their mean height, AND the atrium overlaps the ventricle over no more than 62% of the atrium's own height"
    },
    {
     "id": "E",
     "says": "the bulbus lies VENTRAL to the ventricle",
     "must": "bulbus z - ventricle z > 0"
    },
    {
     "id": "F",
     "says": "the bulbus lies to the RIGHT of the ventricle",
     "must": "bulbus x - ventricle x < 0"
    },
    {
     "id": "G",
     "says": "the two sit SIDE BY SIDE, not one ABOVE the other",
     "must": "|dx| > |dy| for bulbus minus ventricle"
    },
    {
     "id": "H",
     "says": "the two sit SIDE BY SIDE, not one BEHIND the other",
     "must": "|dx| > |dz| for bulbus minus ventricle, at t = 1 AND at the t view 4 renders (0.65)"
    },
    {
     "id": "I",
     "says": "the primitive ventricle finishes LEFT of the median plane, visibly",
     "must": "ventricle centroid x >= 0.35 x the ventricle's own width"
    },
    {
     "id": "J",
     "says": "the common atrium STRADDLES the median plane",
     "must": "at least 28% of the atrium's width lies on EACH side of x = 0, and its centroid is within 30% of its width of the median plane"
    },
    {
     "id": "K",
     "says": "the sinus venosus straddles it too, and REACHES onto the embryo's RIGHT",
     "must": "at least 22% of the sinus's width lies at x < 0, and its centroid is within 38% of its width of the median plane"
    },
    {
     "id": "L",
     "says": "the ventricle and the bulbus are two limbs on OPPOSITE sides of the cavity",
     "must": "the transverse separation of their centres is at least 85% of the distance at which the two chambers would be tangent, at t = 1"
    },
    {
     "id": "M",
     "says": "the mirror variant is a REFLECTION, not a rotation",
     "must": "the signed volume of the sinus-atrium-ventricle-bulbus centroid tetrahedron NEGATES (ratio -1)"
    }
   ]
  }
 },
