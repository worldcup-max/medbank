<script>
(function(){
  var $=function(id){return document.getElementById(id);};
  if(!$('liScene')) return;
  var scene=$('liScene');
  function resetCursor(){ var c=$('liCursor'); c.style.left='40px'; c.style.top='60px'; }
  function moveTo(el, cb){ if(!el){cb&&cb();return;} var main=$('liCursor').parentNode, mr=main.getBoundingClientRect(), er=el.getBoundingClientRect();
    var c=$('liCursor'); c.style.left=(er.left-mr.left+Math.min(er.width/2,90))+'px'; c.style.top=(er.top-mr.top+er.height/2-8)+'px';
    setTimeout(function(){ c.classList.add('click'); setTimeout(function(){ c.classList.remove('click'); cb&&cb(); },320); },1250); }

  function pick(){
    scene.innerHTML='<div class="lih">Add a lecture</div><div class="lisub">Paediatrics · Dr. Ojike · choose how to import</div>'
      + '<div class="litiles">'
      + '<div class="litile" id="liPdf"><div class="ic">📄</div><div><b>PDF or slides</b><span>lecture handout</span></div></div>'
      + '<div class="litile"><div class="ic">📷</div><div><b>Photos of notes</b><span>handwritten too</span></div></div>'
      + '<div class="litile"><div class="ic">▶️</div><div><b>YouTube link</b><span>we transcribe it</span></div></div>'
      + '<div class="litile"><div class="ic">🎙️</div><div><b>Record live</b><span>right in class</span></div></div></div>';
    resetCursor();
    setTimeout(function(){ moveTo($('liPdf'), function(){ $('liPdf').classList.add('on'); setTimeout(upload, 550); }); }, 1100);
  }

  function upload(){
    scene.innerHTML='<div class="lih">Add a lecture</div><div class="lisub">File selected — ready to build</div>'
      + '<div class="lifile"><div class="fic">📄</div><div><b>Bronchiolitis — lecture.pdf</b><span>18 slides · 2.4 MB</span></div></div>'
      + '<button class="libtn" id="liBuild">✨ Build my study set</button>';
    resetCursor();
    setTimeout(function(){ moveTo($('liBuild'), building); }, 1000);
  }

  var STEPS=['Reading the lecture','Writing a clean note','Simplifying it','Making flashcards','Building quizzes','Recording the podcast'];
  function building(){
    var rows=STEPS.map(function(s,i){return '<div class="listep" id="ls'+i+'"><span class="ck">✓</span>'+s+'</div>';}).join('');
    scene.innerHTML='<div class="lih">Building your study set…</div><div class="lisub">This normally takes a minute or two in the app</div>'
      + '<div class="libar"><i id="liFill"></i></div>'+rows;
    resetCursor();
    var i=0;
    (function next(){
      if(i<STEPS.length){
        if(i>0) $('ls'+(i-1)).className='listep done';
        $('ls'+i).className='listep run';
        $('liFill').style.width=Math.round((i+0.5)/STEPS.length*100)+'%';
        i++; setTimeout(next, 780);
      } else { $('ls'+(STEPS.length-1)).className='listep done'; $('liFill').style.width='100%'; setTimeout(ready, 700); }
    })();
  }

  function ready(){
    var outs=[['📖','Built note','full, tidy'],['📝','Simplified note','plain English'],['🃏','Flashcards','2 decks'],['✓','Quiz &amp; written','MCQ + short'],['📄','Cram sheet','1-page recap'],['🎧','Podcast','two-host episode']];
    scene.innerHTML='<div class="liready">🎉 Your study set is ready</div>'
      + '<div class="ligrid">'+outs.map(function(o,i){return '<div class="lout" style="animation-delay:'+(i*0.09)+'s"><span>'+o[0]+'</span><div>'+o[1]+'<small>'+o[2]+'</small></div></div>';}).join('')+'</div>';
    resetCursor();
    setTimeout(pick, 5200);
  }

  setTimeout(pick, 800);
})();
</script>
